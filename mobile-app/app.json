{
  "expo": {
    "name": "Pickzy",
    "slug": "pickzy",
    "version": "1.0.0",
    "scheme": "pickzy",
    "orientation": "portrait",
    "icon": "./public/images/app-icon/ios-icon-default.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F6FF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.abdullahalmaksud.pickzy",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "bn"
        ]
      }
    },
    "android": {
      "package": "app.abdullahalmaksud.pickzy",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./public/images/app-icon/android-icon-foreground.png",
        "backgroundImage": "./public/images/app-icon/android-icon-background.png",
        "monochromeImage": "./public/images/app-icon/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./public/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-vector-icons/lucide",
      [
        "expo-splash-screen",
        {
          "image": "./public/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "bn"
            ],
            "android": [
              "en",
              "bn"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pickzy uses your photos only to set your profile picture. The photo stays on this device."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dcc0d5d0-3d26-4492-a4bc-25e50a747e33"
      }
    },
    "owner": "abdullahalmaksud"
  }
}
